# ─────────────────────────────────────────────────────────────
# LinkedIn Connections Intelligence — environment config
# Copy to  backend/.env  and fill in.  NEVER commit backend/.env
# ─────────────────────────────────────────────────────────────

# ── Apify (LinkedIn profile enrichment) ──────────────────────
APIFY_API_TOKEN=
APIFY_ACTOR_ID=LpVuK3Zozwuipa5bp
APIFY_PROFILE_SCRAPER_MODE=Profile details no email ($4 per 1k)

# ── Anthropic — the PRIMARY intelligence layer ──────────────
# Anthropic understands profile meaning and search intent. A CONFIGURED key IS
# the opt-in — set ANTHROPIC_API_KEY and Anthropic is used first for every LLM
# step (query interpretation, semantic judging, final audit, explanations). No
# separate enable flag needed. This is a PAID API — see README for usage.
ANTHROPIC_API_KEY=
# Production default: claude-sonnet-5 (PART 6 benchmark — most reliable structured
# output + zero evidence-ref hallucination for this workload). Any Claude model ID
# works; Claude 5 models require the no-prefill / no-temperature request shape the
# client already sends.
ANTHROPIC_MODEL=claude-sonnet-5
# Only for "identity-linked" keys (accounts with multiple workspaces). A normal
# personal/console API key works fine WITHOUT this set.
ANTHROPIC_WORKSPACE_ID=
# DEPRECATED — a configured ANTHROPIC_API_KEY is itself the opt-in now. Left
# readable so an old .env file doesn't error.
ENABLE_PAID_LLM=false
ANTHROPIC_FIRST=true

# ── Optional fallback providers ─────────────────────────────
# Order when configured: Anthropic -> Groq primary -> Groq fallback ->
# OpenRouter -> local/deterministic. Unconfigured providers are simply
# skipped. Safe to leave both blank if Anthropic alone is enough.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_MAX_RETRIES=2

# ── Provider circuit breaker (V4 §8, process-local, not persisted) ─
LLM_PROVIDER_COOLDOWN_SECONDS=90               # transient (429 / 5xx / transport)
ANTHROPIC_CONFIG_FAILURE_COOLDOWN_SECONDS=900  # bad key / workspace / model

# ── Embeddings (local sentence-transformers, no key, no cost) ─
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Database (SQLite for MVP; swap DATABASE_URL for Postgres) ─
DATABASE_URL=sqlite:///./data/app.db

# ── Enrichment / cost controls ──────────────────────────────
ENVIRONMENT=development
# true  = local fixture profiles, NO Apify calls (this is what the automated
#         test suite always uses, regardless of this file).
# false = real Apify enrichment with APIFY_API_TOKEN. Set this to false for a
#         normal real-user installation — leaving it true silently fakes every
#         profile instead of scraping LinkedIn.
USE_FIXTURES=false
DEVELOPMENT_BATCH_SIZE=5
PRODUCTION_BATCH_SIZE=50
APIFY_PROFILE_BATCH_SIZE=50
MAX_APIFY_RETRIES=2
APIFY_MAX_CHARGE_USD=0
PROFILE_TTL_DAYS=30

# ── Search ──────────────────────────────────────────────────
CANDIDATE_POOL_SIZE=60
TOP_CONNECTIONS=20
MIN_MATCH_SCORE=12
SEMANTIC_ENABLED=true

# ── Search quality v2 ───────────────────────────────────────
RELEVANCE_WEIGHT=20                # points for whole-profile relevance (embedding + reranker)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_POOL=40
RERANK_BLEND=0.6                   # cross-encoder share within the relevance component
LLM_RERANK_ENABLED=false           # opt-in LLM reorder of the final top 20
RECENCY_WEIGHTING_ENABLED=true
COMPANY_ID_MATCHING=true

# ── Exhaustive semantic judge (V4 PART 3) ───────────────────
# off | uncertain_only | all_viable.  all_viable = judge EVERY candidate that
# passes the hard-fact gate (correct for a ~1k network; costs LLM tokens).
SEMANTIC_JUDGE_MODE=all_viable
# 0 = NO artificial cap after hard-fact gating. A positive value caps the judged
# set and the response reports judge_metadata.capped=true (never a silent cap).
SEMANTIC_JUDGE_MAX_CANDIDATES=0
SEMANTIC_JUDGE_BATCH_SIZE=10
SEMANTIC_JUDGE_MAX_PACKET_CHARS=7000
SEMANTIC_JUDGE_MAX_BATCH_CHARS=48000
# 0 = unlimited. Optional soft cap on LLM calls AFTER query interpretation
# (judge + audit + reason, combined). Never causes an incorrect result — once
# hit, remaining optional LLM work is skipped, deterministic results stand,
# and judge/audit status is reported PARTIAL instead of FULL.
SEARCH_LLM_MAX_CALLS=0
# Optional end-to-end request budget (seconds).
#   0  (default) = NO application-level search deadline. A broad semantic query
#                  keeps processing every required judge batch + the final audit
#                  until verification finishes, however long that takes. Elapsed
#                  wall time alone NEVER produces verification_incomplete /
#                  ai_unavailable — only real provider failures do.
#   > 0          = an operator-configured safety ceiling. Every expensive stage
#                  checks the remaining time and will not start work it cannot
#                  finish; if it expires BEFORE required AI verification
#                  completes, the search returns
#                  search_status=verification_incomplete with results=[] (NEVER
#                  a deterministic fallback).
# Very broad semantic queries can take several minutes and many LLM calls; no
# search is promised to finish within any fixed time.
SEARCH_MAX_SECONDS=0
# V4 PART 6 B2 — the hard product rule: NO user-visible results unless an LLM
# successfully participated. Interpretation fell back to the regex parser ->
# ai_unavailable; required semantic judge produced 0 valid verdicts ->
# verification_incomplete. Deterministic code still filters/scores internally.
REQUIRE_LLM_FOR_RESULTS=true
# V4 PART 6 B13 — when true, ONLY Anthropic may verify a search; any Anthropic
# failure -> ai_unavailable (no Groq/OpenRouter fallback for the final result).
# When false, the fallback chain may verify, but SOME successful LLM
# verification is still mandatory.
SEARCH_REQUIRE_ANTHROPIC=false

# ── Final result audit (V4 PART 5) ─────────────────────────
# ONE grounded LLM correctness review of the candidates about to be shown.
# Downgrade / remove only — it can never upgrade POSSIBLE->EXACT or invent a
# score. Set to false to skip it entirely.
FINAL_RESULT_AUDIT_ENABLED=true
# V4 PART 6 B10 — when true, a search shows results only if the final audit
# completed (an incomplete audit -> verification_incomplete, results=[]). The
# PART 6 judge compaction brought normal-search audit completion to ~100%.
SEARCH_REQUIRE_FINAL_AUDIT=true
# DEPRECATED (V4 PART 5.5) — TOP_CONNECTIONS is the one authoritative result
# count. A value here that disagrees with TOP_CONNECTIONS is ignored (logged).
# The audit pool is TOP_CONNECTIONS + FINAL_RESULT_AUDIT_BUFFER.
FINAL_RESULT_AUDIT_TOP_N=20
FINAL_RESULT_AUDIT_BUFFER=10
FINAL_RESULT_AUDIT_BATCH_SIZE=10
FINAL_RESULT_AUDIT_MAX_PACKET_CHARS=6000
FINAL_RESULT_AUDIT_MAX_BATCH_CHARS=44000

# ── Current-user profile (V4 PART 2) ────────────────────────
# Only used to resolve relational queries like "anyone in my field" or
# "a mentor in my space". Leave blank and such a query is marked UNRESOLVED
# (confidence is lowered) instead of the searcher's field being guessed.
USER_FIELD=
USER_CURRENT_ROLE=
USER_GOAL=

# ── App ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
LOG_LEVEL=INFO
